              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "quote_needed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Needed"
        }
      },
      "required": [
        "label",
        "quantity",
        "unit",
        "basis",
        "geography"
      ],
      "title": "CostComponent",
      "type": "object"
    },
    "Tactic": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "kpi_id": {
          "title": "Kpi Id",
          "type": "string"
        },
        "budget_line_id": {
          "title": "Budget Line Id",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "string"
        },
        "status": {
          "default": "planned",
          "enum": [
            "planned",
            "in_progress",
            "completed"
          ],
          "title": "Status",
          "type": "string"
        }
