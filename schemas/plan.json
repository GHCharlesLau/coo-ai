    },
    "budget_lines": {
      "items": {
        "$ref": "#/$defs/BudgetLine"
      },
      "title": "Budget Lines",
      "type": "array"
    },
    "estimate_as_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimate As Of"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
