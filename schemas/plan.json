{
  "$defs": {
    "BudgetLine": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "low_amount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low Amount"
        },
        "high_amount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High Amount"
        },
        "estimate_status": {
          "default": "complete",
          "enum": [
            "complete",
            "assumption",
            "partial",
            "unpriced"
          ],
          "title": "Estimate Status",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/CostComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "quote_needed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Needed"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "BudgetLine",
      "type": "object"
    },
    "CostComponent": {
