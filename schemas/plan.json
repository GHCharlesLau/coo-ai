        "type": "string"
      },
      "title": "Channels",
      "type": "array"
    },
    "tactics": {
      "items": {
        "$ref": "#/$defs/Tactic"
      },
      "title": "Tactics",
      "type": "array"
    },
    "timeline_start": {
      "title": "Timeline Start",
      "type": "string"
    },
    "timeline_end": {
      "title": "Timeline End",
      "type": "string"
    },
    "budget_currency": {
      "default": "USD",
      "title": "Budget Currency",
      "type": "string"
    },
    "budget_cap": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
