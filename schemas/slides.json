  "properties": {
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "theme": {
      "default": "editorial",
      "enum": [
        "editorial",
        "navy_gold"
      ],
      "title": "Theme",
      "type": "string"
    },
    "budget_total": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Total"
    },
    "budget_low": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Low"
    },
    "budget_high": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget High"
    },
    "budget_complete": {
      "default": true,
      "title": "Budget Complete",
      "type": "boolean"
    },
    "budget_currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Currency"
    },
    "kpi_ids": {
      "items": {
        "type": "string"
      },
      "title": "Kpi Ids",
      "type": "array"
    },
    "tactic_ids": {
      "items": {
        "type": "string"
      },
      "title": "Tactic Ids",
      "type": "array"
    },
    "slides": {
      "items": {
        "$ref": "#/$defs/SlideSpec"
      },
      "title": "Slides",
      "type": "array"
    },
    "template_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Path"
    },
    "palette": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Palette",
      "type": "object"
    },
    "font_heading": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Font Heading"
    },
    "font_body": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Font Body"
    },
    "design": {
      "$ref": "#/$defs/DesignSpec"
    }
