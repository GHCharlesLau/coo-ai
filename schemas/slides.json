        "stats": {
          "items": {
            "$ref": "#/$defs/StatSpec"
          },
          "maxItems": 4,
          "title": "Stats",
          "type": "array"
        },
        "images": {
          "items": {
            "$ref": "#/$defs/ImageSpec"
          },
          "maxItems": 4,
          "title": "Images",
          "type": "array"
        },
        "matrix": {
          "anyOf": [
            {
              "$ref": "#/$defs/MatrixSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
