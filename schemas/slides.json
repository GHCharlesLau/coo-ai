      "required": [
        "layout",
        "title"
      ],
      "title": "SlideSpec",
      "type": "object"
    },
    "StatSpec": {
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "source_note": {
          "default": "",
          "title": "Source Note",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "StatSpec",
      "type": "object"
    },
    "TableSpec": {
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "align": {
          "items": {
            "enum": [
              "left",
              "center",
              "right"
            ],
            "type": "string"
