        "column_widths": {
          "items": {
            "type": "number"
          },
          "title": "Column Widths",
          "type": "array"
        },
        "source_note": {
          "default": "",
          "title": "Source Note",
          "type": "string"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "TableSpec",
      "type": "object"
    }
