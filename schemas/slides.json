{
  "$defs": {
    "ChartSeries": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "label",
        "values"
      ],
      "title": "ChartSeries",
      "type": "object"
    },
    "ChartSpec": {
      "properties": {
        "kind": {
          "enum": [
            "bar",
            "line",
            "donut",
            "horizontal_bar",
            "stacked_bar"
          ],
          "title": "Kind",
          "type": "string"
        },
        "categories": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Categories",
          "type": "array"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/ChartSeries"
          },
          "minItems": 1,
          "title": "Series",
          "type": "array"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "axis_label": {
          "default": "",
          "title": "Axis Label",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "categories",
        "series"
      ],
      "title": "ChartSpec",
      "type": "object"
    },
    "DesignSpec": {
      "properties": {
        "density": {
          "default": "balanced",
          "enum": [
            "airy",
            "balanced",
            "dense"
          ],
          "title": "Density",
          "type": "string"
        },
        "visual_ratio": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Visual Ratio",
          "type": "number"
        },
        "reference_style": {
          "default": "",
          "title": "Reference Style",
          "type": "string"
        },
        "style": {
          "default": "editorial",
          "enum": [
            "editorial",
            "brief",
            "report"
          ],
          "title": "Style",
          "type": "string"
        },
        "accent_mode": {
          "default": "contrast",
          "enum": [
            "contrast",
            "warm",
            "mono"
          ],
          "title": "Accent Mode",
          "type": "string"
        },
        "variant": {
          "default": "auto",
          "title": "Variant",
          "type": "string"
        }
      },
      "title": "DesignSpec",
      "type": "object"
    },
    "DiagramEdge": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "DiagramEdge",
      "type": "object"
    },
    "DiagramNode": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "DiagramNode",
      "type": "object"
    },
    "DiagramSpec": {
      "properties": {
        "kind": {
          "enum": [
            "flow",
            "framework",
            "timeline"
          ],
          "title": "Kind",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/DiagramNode"
          },
          "minItems": 2,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DiagramEdge"
          },
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "nodes"
      ],
      "title": "DiagramSpec",
      "type": "object"
    },
    "ImageSpec": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "alt_text": {
          "title": "Alt Text",
          "type": "string"
        },
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        },
        "rights_status": {
          "enum": [
            "supplied",
            "licensed"
          ],
          "title": "Rights Status",
          "type": "string"
        },
        "usage": {
          "title": "Usage",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "creator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Creator"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "placement": {
          "default": "right",
          "enum": [
            "right",
            "left",
            "full_bleed",
            "inset"
          ],
          "title": "Placement",
          "type": "string"
        }
      },
      "required": [
        "path",
        "alt_text",
        "rights_status",
        "usage"
      ],
      "title": "ImageSpec",
      "type": "object"
    },
    "MatrixCellSpec": {
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "tone": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Tone",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "MatrixCellSpec",
      "type": "object"
    },
    "MatrixSpec": {
      "properties": {
        "x_label": {
          "default": "Likelihood",
          "title": "X Label",
          "type": "string"
        },
        "y_label": {
          "default": "Impact",
          "title": "Y Label",
          "type": "string"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/MatrixCellSpec"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Cells",
          "type": "array"
        }
      },
      "required": [
        "cells"
      ],
      "title": "MatrixSpec",
      "type": "object"
    },
    "SlideSpec": {
      "properties": {
        "layout": {
          "enum": [
            "title",
            "section",
            "bullets",
            "two_column",
            "kpis",
            "budget",
            "quote",
            "references",
            "next_steps",
            "diagram",
            "timeline",
            "chart",
            "photo",
            "table",
            "stats",
            "gallery",
            "comparison",
            "map",
            "matrix"
